{
  "name": "my-design-tokens",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens:clean": "rimraf dist/tokens .tmp",
    "tokens:prepare": "tsx scripts/prepare-tokens.ts",
    "build": "npm run tokens:prepare && tsx style-dictionary/build.ts",
    "tokens:watch": "chokidar 'src/tokens/**/*.json' -c 'npm run build'"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "chokidar-cli": "^3.0.0",
    "rimraf": "^6.0.1",
    "style-dictionary": "^3.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.3"
  }
}
